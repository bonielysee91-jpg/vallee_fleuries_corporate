# ---------------------------------------------------------------------------
# Vallées Fleuries Corporate — variables d'environnement
# Copiez ce fichier vers `.env` puis renseignez les valeurs réelles.
# `.env` ne doit JAMAIS être commité.
# ---------------------------------------------------------------------------

# --- Base de données (Neon) -------------------------------------------------
# Connexion Neon via @prisma/adapter-neon (HTTPS/WSS, port 443 : le port 5432 est bloqué).
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"
# Taille du pool de connexions serverless (optionnel, défaut : 10).
DB_POOL_SIZE="10"

# --- Exécution --------------------------------------------------------------
# "production" active les contrôles de sécurité stricts (secrets obligatoires, SMS réel...).
NODE_ENV="production"
# Port d'écoute du serveur Express (défaut : 3000).
PORT="3000"

# --- Sécurité JWT -----------------------------------------------------------
# OBLIGATOIRE en production : le serveur refuse de démarrer si absent.
JWT_SECRET="remplacez-par-une-chaine-aleatoire-de-64-caracteres-minimum"
# Optionnel : secret distinct pour les jetons de rafraîchissement (défaut : JWT_SECRET).
JWT_REFRESH_SECRET=""

# --- Bootstrap Super-Admin (Direction Générale) -----------------------------
# Le compte est créé (ou promu SUPER_ADMIN) automatiquement au démarrage du serveur.
# Idempotent : un compte privilégié existant n'est jamais modifié.
# ADMIN_PASSWORD doit contenir au moins 10 caractères, sinon l'opération est ignorée.
ADMIN_EMAIL="direction@valleesfleuries.ci"
ADMIN_PASSWORD="mot-de-passe-super-admin-10-caracteres-min"
# Requis uniquement pour CRÉER le compte ; ignoré si le compte existe déjà.
ADMIN_PHONE="01-73-83-95-18"
ADMIN_FULLNAME="Direction Générale VFC"

# --- Comptes d'exemple du seed (prisma/seed.ts) -----------------------------
# Mots de passe des comptes de démonstration. S'ils ne sont pas définis,
# un mot de passe aléatoire est généré et affiché une seule fois par le seed
# (aucun secret n'est stocké dans le code). Laisser vide = aléatoire.
SEED_ADMIN_PASSWORD=""
SEED_OWNER_PASSWORD=""
SEED_TENANT_PASSWORD=""

# --- Passerelle SMS (OTP) ---------------------------------------------------
# Priorité 1 : Orange SMS API (Côte d'Ivoire) — nécessite un compte developer.orange.com.
ORANGE_SMS_CLIENT_ID=""
ORANGE_SMS_CLIENT_SECRET=""
# Numéro expéditeur imposé par Orange (par défaut : +2250000).
ORANGE_SMS_SENDER_NUMBER="+2250000"
# Sender name personnalisé (11 caractères max, validation Orange préalable).
ORANGE_SMS_SENDER_NAME=""
# Priorité 2 : agrégateur tiers atteignant MTN et Moov (Nimba, Semoa, Twilio...).
SMS_API_URL=""
SMS_API_KEY=""

# --- E-mail transactionnel (SMTP via nodemailer) -----------------------------
# Utilisé pour envoyer les invitations administrateur du Command Center.
# Tant que ces trois valeurs ne sont pas renseignées, aucun e-mail n'est émis :
# le code d'invitation est alors renvoyé à l'administrateur qui le transmet lui-même.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# true pour une connexion TLS implicite (port 465). Défaut : false (STARTTLS, port 587).
SMTP_SECURE="false"
# Expéditeur affiché dans les e-mails (format : "Nom <adresse@domaine>").
MAIL_FROM="Vallées Fleuries Corporate <no-reply@valleesfleuries.ci>"

# --- Paiement mobile money (CinetPay) ---------------------------------------
# Secret HMAC-SHA256 pour vérifier la signature des webhooks de paiement.
MOBILE_MONEY_WEBHOOK_SECRET=""
# Double vérification anti-falsification via l'API CinetPay.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_CHECK_URL="https://api-checkout.cinetpay.com/v2/payment/check"

# --- Passerelle Wave (checkout hébergé) -------------------------------------
# Clé API Wave Business : si renseignée, le paiement Wave redirige vers la page
# de paiement Wave. Sinon, la transaction reste PENDING sans redirection.
WAVE_API_KEY=""
WAVE_CHECKOUT_URL="https://api.wave.com/v1/checkout/sessions"
# Secret de signature des webhooks Wave (`whsec_…`) : authentifie les notifications.
WAVE_WEBHOOK_SECRET=""

# --- Orange Money Web Payment (checkout hébergé) ----------------------------
# Identifiants Orange Developer (distincts de ceux du SMS) : consumer key/secret
# + clé marchand Web Payment. Si les trois sont renseignés, le paiement Orange
# redirige vers la page Orange. Sinon, la transaction reste PENDING.
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_WEBPAY_URL="https://api.orange.com/orange-money-webpay/ci/v1/webpayment"
# Devise : "XOF" (défaut) ou "OUV" pour certains comptes marchands hérités.
ORANGE_MONEY_CURRENCY="XOF"
# Base de l'API de statut (le notif_token est ajouté en suffixe) : sert à authentifier
# les notifications Orange, qui ne sont pas signées.
ORANGE_MONEY_STATUS_URL="https://api.orange.com/orange-money-webpay/ci/v1/webpayment"

# --- Divers -----------------------------------------------------------------
# GEMINI_API_KEY: requis pour les appels à l'API Gemini AI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: URL publique où l'application est hébergée (liens, callbacks OAuth...).
APP_URL="MY_APP_URL"
# true pour désactiver le HMR de Vite (utile sur certains environnements conteneurisés).
DISABLE_HMR="false"
